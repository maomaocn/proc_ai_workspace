# Application
APP_NAME=Enterprise AI Agent Hub
APP_ENV=local
APP_VERSION=0.7.0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# PostgreSQL
POSTGRES_DB=enterprise_ai_agent_hub
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5432
# Local Python/Conda connection.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/enterprise_ai_agent_hub
# Docker Compose API connection. The hostname is the Compose service name.
COMPOSE_DATABASE_URL=postgresql+asyncpg://app:app@db:5432/enterprise_ai_agent_hub
# LangGraph official PostgreSQL checkpointer uses psycopg rather than asyncpg.
CHECKPOINT_DATABASE_URL=postgresql://app:app@localhost:5432/enterprise_ai_agent_hub
COMPOSE_CHECKPOINT_DATABASE_URL=postgresql://app:app@db:5432/enterprise_ai_agent_hub
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Authentication. Replace this value outside local demo environments.
JWT_SECRET_KEY=local-demo-change-me-before-deployment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
SEED_DEMO_DATA=true

# Model providers default to deterministic local Mock mode.
MODEL_PROVIDER=mock
EMBEDDING_PROVIDER=mock

# Optional OpenAI-compatible provider settings. Keep secrets out of Git.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
MODEL_REQUEST_TIMEOUT_SECONDS=20
REMOTE_EMBEDDING_BASE_URL=
REMOTE_EMBEDDING_API_KEY=
REMOTE_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=256
EMBEDDING_REQUEST_TIMEOUT_SECONDS=20

# M2 knowledge base and local Chroma persistence.
KNOWLEDGE_UPLOAD_DIR=./data/uploads
KNOWLEDGE_MAX_FILE_BYTES=20971520
KNOWLEDGE_CHUNK_SIZE=700
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_MAX_UPLOAD_FILES=10
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION_NAME=enterprise_ai_knowledge
RAG_MIN_SCORE=0.12

# M3-M5 unified read-only Tool Registry limits.
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RESULT_ITEMS=50
TOOL_RETRY_MAX_ATTEMPTS=2
TOOL_RETRY_BACKOFF_MS=50

# M5 local stdio MCP and Mini Agent Harness. No remote credentials are required.
MCP_SERVER_MODULE=app.mcp.server
MCP_SERVER_EXPECTED_NAME=enterprise-ai-agent-hub-mcp
MCP_SERVER_TRANSPORT=stdio
AGENT_MAX_STEPS=12
AGENT_TOTAL_TIMEOUT_SECONDS=90
AGENT_TRACE_SUMMARY_MAX_CHARS=1200

# Frontend build-time API route. Docker Compose uses the Nginx /api proxy.
VITE_API_BASE_URL=/api
